{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reqglide",
  "version": "0.1.1",
  "identifier": "dev.localfirst.apiclient",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reqglide",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "shortDescription": "Reqglide, a fast, local-first API development client.",
    "longDescription": "Build, test, organize, and migrate HTTP, GraphQL, WebSocket, SSE, and gRPC APIs without an account or mandatory cloud workspace.",
    "windows": {
      "wix": {
        "upgradeCode": "8f473f52-f229-57b6-a782-976bea1737de"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
